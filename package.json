{
  "name": "tabularium",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @tabularium/db --",
    "db:studio": "turbo run db:studio -F @tabularium/db --",
    "db:generate": "turbo run db:generate -F @tabularium/db --",
    "db:migrate": "turbo run db:migrate -F @tabularium/db --"
  },
  "dependencies": {
    "@tabularium/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tabularium/config": "workspace:*",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.1.2"
}
