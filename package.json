{
  "name": "tabularium",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "check-types": "tsc --noEmit",
    "start": "next start --hostname localhost --port 3000",
    "db:push": "turbo run db:push -F @tabularium/db --",
    "db:studio": "turbo run db:studio -F @tabularium/db --",
    "db:generate": "turbo run db:generate -F @tabularium/db --",
    "db:migrate": "turbo run db:migrate -F @tabularium/db --",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@swc/helpers": "^0.5.23",
    "@tabularium/env": "workspace:*",
    "@tabularium/ui": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "catalog:",
    "lucide-react": "catalog:",
    "next": "^16.3.0",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tabularium/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "^20.19.43",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.1.2"
}
